<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FileExplorer.Gui.ViewModels"
        xmlns:models="using:FileExplorer.Core.Models"
        xmlns:m="using:FileExplorer.Gui.Models"
        xmlns:markup="using:FileExplorer.Gui.Markup"
        xmlns:controls="using:FileExplorer.Gui.Controls"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="700"
        x:Class="FileExplorer.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        KeyDown="OnWindowKeyDown"
        Title="Ferret"
        Icon="/Assets/folder.ico"
        Width="1050"
        Height="700"
        MinWidth="650"
        MinHeight="420"
        DragDrop.AllowDrop="True"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
    
    <Window.Styles>
        <Style Selector="Border.symlink-badge">
            <Setter Property="Background" Value="#2B2B30"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.symlink-badge > Path">
            <Setter Property="Stroke" Value="#E0E0E0"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
        </Style>

        <Style Selector="Button.view-toggle">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.view-toggle.boxed">
            <Setter Property="Background" Value="#18181A"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Button.view-toggle.active">
            <Setter Property="Background" Value="#4A4A50"/>
        </Style>

        <Style Selector="ToggleButton.view-toggle">
            <Setter Property="Background" Value="#18181A"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="ToggleButton.view-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4A4A50"/>
            <Setter Property="BorderBrush" Value="#383838"/>
        </Style>

        <Style Selector="ToggleButton.view-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#56565C"/>
        </Style>

        <Style Selector="Button.crumb">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.crumb.current">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.crumb-scroll">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.crumb-scroll:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Button.crumb-scroll:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <Style Selector="Border.drop-target">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <Style Selector="Border.pane-box">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style Selector="Border.pane-box.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>

        <Style Selector="ListBox.file-list">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Background" Value="#1A1A1C"/>
            <Setter Property="DragDrop.AllowDrop" Value="True"/>
        </Style>

        <Style Selector="ListBox.file-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionSubtleBrush}"/>
        </Style>

        <Style Selector="Button.operation-tab">
            <Setter Property="Background" Value="#2B2B30"/>
            <Setter Property="BorderBrush" Value="#38383E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
        </Style>

        <Style Selector="Button.operation-tab.selected">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.operation-tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Button.addon-errors">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.addon-status">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.addon-status.clickable">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.addon-status:not(.clickable):pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="Border.sort-header">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Border.sort-header:pointerover TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>

        <Style Selector="Border.col-resize">
            <Setter Property="Width" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Cursor" Value="SizeWestEast"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
        <DataTemplate x:Key="FilePaneTemplate"
                      x:DataType="vm:PaneViewModel">
            <Border CornerRadius="6"
                    Classes="pane-box"
                    Classes.active="{Binding IsActive}">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- Trash Action Banner -->
                    <Border Grid.Row="0"
                            Background="#2B1A1A"
                            BorderBrush="#552222"
                            BorderThickness="0,0,0,1"
                            Padding="12,8"
                            IsVisible="{Binding IsInTrash}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Image Source="{markup:Icon Key=trash}"
                                       Width="18"
                                       Height="18"/>

                                <TextBlock Text="{markup:Translate Key=Trash}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="#E0E0E0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button Click="OnRecoverClick"
                                        IsEnabled="{Binding IsItemSelected}"
                                        Background="#2E5E3A"
                                        Foreground="White"
                                        Padding="12,5"
                                        CornerRadius="6"
                                        FontSize="12">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <Image Source="{markup:Icon Key=trash-restore}"
                                               Width="14"
                                               Height="14"/>

                                        <TextBlock Text="{markup:Translate Key=RecoverSelected}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Click="OnEmptyTrashClick"
                                        IsEnabled="{Binding !!Items.Count}"
                                        Background="#C0392B"
                                        Foreground="White"
                                        Padding="12,5"
                                        CornerRadius="6"
                                        FontSize="12">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <Image Source="{markup:Icon Key=trash-empty}"
                                               Width="14"
                                               Height="14"/>

                                        <TextBlock Text="{markup:Translate Key=EmptyTrash}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Column Headers (Only for List View) -->
                    <Border Grid.Row="1"
                            Background="#212123"
                            BorderBrush="#2C2C2C"
                            BorderThickness="0,0,0,1"
                            Padding="12,6"
                            IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsListView}">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                            <Panel Grid.Column="0"
                                   Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColNameWidth}">
                                <Border Classes="sort-header"
                                        Tag="Name"
                                        Margin="0,0,8,0"
                                        HorizontalAlignment="Stretch"
                                        Tapped="OnSortHeaderTapped">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                Spacing="4">
                                        <TextBlock Text="{markup:Translate Key=Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#888888"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>

                                        <Image Source="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortArrowIcon}"
                                               Width="12"
                                               Height="12"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSortedByName}"/>
                                    </StackPanel>
                                </Border>

                                <Border Tag="Name"
                                        Classes="col-resize"
                                        PointerPressed="OnColResizePointerPressed"
                                        PointerMoved="OnColResizePointerMoved"
                                        PointerReleased="OnColResizePointerReleased"
                                        PointerCaptureLost="OnColResizePointerCaptureLost"/>
                            </Panel>

                            <Panel Grid.Column="1"
                                   Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColSizeWidth}">
                                <Border Classes="sort-header"
                                        Tag="Size"
                                        Margin="0,0,16,0"
                                        HorizontalAlignment="Stretch"
                                        Tapped="OnSortHeaderTapped">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="4">
                                        <Image Source="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortArrowIcon}"
                                               Width="12"
                                               Height="12"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSortedBySize}"/>

                                        <TextBlock Text="{markup:Translate Key=Size}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#888888"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Tag="Size"
                                        Classes="col-resize"
                                        PointerPressed="OnColResizePointerPressed"
                                        PointerMoved="OnColResizePointerMoved"
                                        PointerReleased="OnColResizePointerReleased"
                                        PointerCaptureLost="OnColResizePointerCaptureLost"/>
                            </Panel>

                            <Panel Grid.Column="2"
                                   Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColTypeWidth}">
                                <Border Classes="sort-header"
                                        Tag="Type"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        Tapped="OnSortHeaderTapped">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                Spacing="4">
                                        <TextBlock Text="{markup:Translate Key=Type}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#888888"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>

                                        <Image Source="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortArrowIcon}"
                                               Width="12"
                                               Height="12"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSortedByType}"/>
                                    </StackPanel>
                                </Border>

                                <Border Tag="Type"
                                        Classes="col-resize"
                                        PointerPressed="OnColResizePointerPressed"
                                        PointerMoved="OnColResizePointerMoved"
                                        PointerReleased="OnColResizePointerReleased"
                                        PointerCaptureLost="OnColResizePointerCaptureLost"/>
                            </Panel>

                            <Panel Grid.Column="3">
                                <Border Classes="sort-header"
                                        Tag="Modified"
                                        Margin="8,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        Tapped="OnSortHeaderTapped">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Left"
                                                Spacing="4">
                                        <TextBlock Text="{markup:Translate Key=Modified}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#888888"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>

                                        <Image Source="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortArrowIcon}"
                                               Width="12"
                                               Height="12"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSortedByModified}"/>
                                    </StackPanel>
                                </Border>
                            </Panel>
                        </Grid>
                    </Border>

                    <!-- File List Panel with RubberBand Overlay -->
                    <Panel Grid.Row="2"
                           ClipToBounds="True">
                        <Panel.ContextMenu>
                            <ContextMenu Opening="OnFileContextMenuOpening">

                                <!-- New submenu: shown on empty space or folder -->
                                <MenuItem Header="{markup:Translate Key=New}"
                                          Icon="{markup:Icon Key=add}"
                                          Tag="new"
                                          IsVisible="{Binding CanCreateNew}">
                                    <MenuItem Header="{markup:Translate Key=NewFolder}"
                                              Tag="new-folder"
                                              Icon="{markup:Icon Key=folder-new}"
                                              Click="OnNewFolderClick"
                                              InputGesture="{markup:Keybind Id=NewFolder}"/>

                                    <MenuItem Header="{markup:Translate Key=NewFile}"
                                              Tag="new-file"
                                              Icon="{markup:Icon Key=file-new}"
                                              Click="OnNewFileClick"
                                              InputGesture="{markup:Keybind Id=NewFile}"/>
                                </MenuItem>

                                <Separator IsVisible="{Binding CanCreateNew}"/>

                                <MenuItem Header="{markup:Translate Key=Open}"
                                          Icon="{markup:Icon Key=open}"
                                          Tag="open"
                                          Click="OnMenuOpenClick"
                                          IsVisible="{Binding IsItemSelected}"/>

                                <MenuItem Header="{markup:Translate Key=OpenWithMenu}"
                                          Icon="{markup:Icon Key=open-with}"
                                          Tag="open-with"
                                          IsVisible="{Binding IsFileSelected}"/>

                                <MenuItem Header="{markup:Translate Key=OpenAsRoot}"
                                          Icon="{markup:Icon Key=shield}"
                                          Tag="open-as-root"
                                          Click="OnMenuOpenAsRootClick"/>

                                <MenuItem Header="{markup:Translate Key=OpenTerminal}"
                                          Icon="{markup:Icon Key=terminal}"
                                          Tag="open-terminal"
                                          Click="OnMenuOpenTerminalClick"/>

                                <Separator IsVisible="{Binding CanCopyPath}"/>

                                <MenuItem Header="{markup:Translate Key=CopyPathToClipboard}"
                                          Icon="{markup:Icon Key=link}"
                                          Tag="copy-path"
                                          Click="OnMenuCopyPathClick"
                                          IsVisible="{Binding CanCopyPath}"/>

                                <Separator/>

                                <MenuItem Header="{markup:Translate Key=Cut}"
                                          Icon="{markup:Icon Key=content-cut}"
                                          Tag="cut"
                                          Click="OnMenuCutClick"
                                          InputGesture="{markup:Keybind Id=Cut}"
                                          IsVisible="{Binding IsItemSelected}"/>

                                <MenuItem Header="{markup:Translate Key=Copy}"
                                          Icon="{markup:Icon Key=content-copy}"
                                          Tag="copy"
                                          Click="OnMenuCopyClick"
                                          InputGesture="{markup:Keybind Id=Copy}"
                                          IsVisible="{Binding IsItemSelected}"/>

                                <MenuItem Header="{markup:Translate Key=Paste}"
                                          Icon="{markup:Icon Key=content-paste}"
                                          Tag="paste"
                                          Click="OnMenuPasteClick"
                                          InputGesture="{markup:Keybind Id=Paste}"/>

                                <MenuItem Header="{markup:Translate Key=PasteAsSymlink}"
                                          Icon="{markup:Icon Key=link}"
                                          Tag="paste-link"
                                          Click="OnMenuPasteAsSymlinkClick"
                                          InputGesture="{markup:Keybind Id=PasteSymlink}"/>

                                <MenuItem Header="{markup:Translate Key=Duplicate}"
                                          Icon="{markup:Icon Key=duplicate}"
                                          Tag="duplicate"
                                          Click="OnMenuDuplicateClick"
                                          InputGesture="{markup:Keybind Id=Duplicate}"
                                          IsVisible="{Binding IsItemSelected}"/>

                                <MenuItem Header="{markup:Translate Key=Rename}"
                                          Icon="{markup:Icon Key=edit}"
                                          Tag="rename"
                                          Click="OnMenuRenameClick"
                                          InputGesture="{markup:Keybind Id=Rename}"
                                          IsVisible="{Binding IsItemSelected}"/>

                                <MenuItem Header="{markup:Translate Key=Compress}"
                                          Icon="{markup:Icon Key=compress}"
                                          Tag="compress"
                                          Click="OnMenuCompressClick"
                                          IsVisible="{Binding IsItemSelected}"/>

                                <MenuItem Header="{markup:Translate Key=ExtractHere}"
                                          Icon="{markup:Icon Key=extract}"
                                          Tag="extract-here"
                                          Click="OnMenuExtractHereClick"
                                          IsVisible="{Binding CanExtractSelection}"/>

                                <Separator IsVisible="{Binding IsItemSelected}"/>

                                <MenuItem Header="{markup:Translate Key=Trash}"
                                          Icon="{markup:Icon Key=trash}"
                                          Tag="trash"
                                          Click="OnMenuTrashClick"
                                          InputGesture="{markup:Keybind Id=Trash}"
                                          IsVisible="{Binding IsItemSelected}"/>

                                <MenuItem Header="{markup:Translate Key=DeletePermanent}"
                                          Icon="{markup:Icon Key=delete-forever}"
                                          Tag="delete-permanent"
                                          Click="OnMenuDeletePermanentClick"
                                          InputGesture="{markup:Keybind Id=DeletePermanent}"
                                          IsVisible="{Binding IsItemSelected}"/>

                                <Separator IsVisible="{Binding CanBookmarkSelection}"/>

                                <MenuItem Header="{markup:Translate Key=BookmarkFolder}"
                                          Icon="{markup:Icon Key=bookmark}"
                                          Tag="bookmark"
                                          Click="OnMenuBookmarkClick"
                                          IsVisible="{Binding CanBookmarkSelection}"/>

                                <MenuItem x:Name="FolderColorMenuItem"
                                          Header="{markup:Translate Key=FolderColor}"
                                          Icon="{markup:Icon Key=palette}"
                                          Tag="folder-color"
                                          IsVisible="{Binding CanColorSelection}"/>

                                <MenuItem Header="{markup:Translate Key=SharingOptions}"
                                          Icon="{markup:Icon Key=share}"
                                          Tag="share"
                                          Click="OnMenuSharingOptionsClick"
                                          IsVisible="{Binding IsFolderSelected}"/>

                                <Separator/>

                                <MenuItem Header="{markup:Translate Key=Properties}"
                                          Icon="{markup:Icon Key=info}"
                                          Tag="properties"
                                          Click="OnMenuPropertiesClick"
                                          InputGesture="{markup:Keybind Id=Properties}"/>
                            </ContextMenu>
                        </Panel.ContextMenu>

                        <ProgressBar Height="2"
                                     VerticalAlignment="Top"
                                     IsIndeterminate="True"
                                     IsVisible="{Binding ShowLoadingBar}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource AccentBrush}"
                                     ZIndex="100"/>

                        <!-- GRID VIEW -->
                        <ListBox x:Name="GridFilesListBox"
                                 Classes="file-list"
                                 ItemsSource="{Binding Items}"
                                 SelectionMode="Multiple"
                                 SelectedItem="{Binding SelectedItem}"
                                 SelectionChanged="OnFileSelectionChanged"
                                 DoubleTapped="OnFileDoubleTapped"
                                 KeyDown="OnFileKeyDown"
                                 GotFocus="OnPaneGotFocus"
                                 AttachedToVisualTree="OnFileListAttached"
                                 IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsGridView}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:StretchWrapPanel ItemWidth="128"
                                                               ItemHeight="136"
                                                               NameLines="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GridNameLines}"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="CornerRadius" Value="8"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="Margin" Value="4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>

                                <Style Selector="ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>

                                <Style Selector="ListBoxItem:pressed:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>

                                <Style Selector="ListBoxItem.hover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                                </Style>

                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="ZIndex" Value="1"/>
                                    <Setter Property="ClipToBounds" Value="False"/>
                                </Style>

                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="ClipToBounds" Value="False"/>
                                </Style>
                            </ListBox.Styles>

                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileItemViewModel">
                                    <Border Width="120"
                                            CornerRadius="8"
                                            Opacity="{Binding DisplayOpacity}"
                                            Classes.drop-target="{Binding IsDropTarget}">
                                        <Grid RowDefinitions="80,*"
                                              Margin="4">
                                            <Panel Grid.Row="0"
                                                   Classes="drop-zone"
                                                   Background="Transparent"
                                                   Width="76"
                                                   Height="80"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <Border Classes="hit-zone"
                                                        Margin="0,10,0,0"
                                                        IsHitTestVisible="False"/>

                                                <Image Source="{Binding Icon}"
                                                       Width="68"
                                                       Height="68"
                                                       IsVisible="{Binding !HasThumbnail}"/>

                                                <Border CornerRadius="6"
                                                        ClipToBounds="True"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding HasThumbnail}">
                                                    <Image Source="{Binding Thumbnail}"
                                                           MaxWidth="68"
                                                           MaxHeight="68"
                                                           Stretch="Uniform"/>
                                                </Border>

                                                <Border Classes="symlink-badge"
                                                        IsVisible="{Binding IsSymlink}"
                                                        Width="22"
                                                        Height="22"
                                                        CornerRadius="11"
                                                        Margin="0,0,2,4"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom">
                                                    <Path Data="M0,8 L8,0 M2,0 L8,0 L8,6"
                                                          StrokeThickness="1.8"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Border>
                                            </Panel>

                                            <StackPanel Grid.Row="1"
                                                        Spacing="2"
                                                        HorizontalAlignment="Center">
                                                <Panel HorizontalAlignment="Center">
                                                    <TextBlock Classes="hit-zone"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               Foreground="White"
                                                               TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               MaxLines="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GridNameLines}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="110"/>

                                                    <Canvas Width="0"
                                                            Height="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top"
                                                            IsHitTestVisible="False">
                                                        <Canvas.IsVisible>
                                                            <MultiBinding Converter="{x:Static controls:GridNameOverlayConverter.Instance}">
                                                                <Binding Path="$parent[ListBoxItem].IsSelected"/>

                                                                <Binding Path="$parent[ListBox].((vm:PaneViewModel)DataContext).SelectedItems.Count"/>

                                                                <Binding Path="Name"/>

                                                                <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).GridNameLines"/>

                                                                <Binding Path="$parent[ListBoxItem].FontFamily"/>
                                                            </MultiBinding>
                                                        </Canvas.IsVisible>

                                                        <Border Canvas.Left="-60"
                                                                Background="{DynamicResource SelectionSubtleBrush}"
                                                                Width="120"
                                                                CornerRadius="0,0,8,8"
                                                                Padding="5,0,5,8">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13"
                                                                       Foreground="White"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"/>
                                                        </Border>
                                                    </Canvas>
                                                </Panel>

                                                <Border Classes="hit-zone"
                                                        Background="#D35400"
                                                        CornerRadius="3"
                                                        Padding="3,1"
                                                        IsVisible="{Binding IsAccessDenied}"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{markup:Translate Key=AccessDenied}"
                                                               Foreground="White"
                                                               FontSize="9"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- LIST / DETAILS VIEW -->
                        <ListBox x:Name="ListFilesListBox"
                                 Classes="file-list"
                                 ItemsSource="{Binding Items}"
                                 SelectionMode="Multiple"
                                 SelectedItem="{Binding SelectedItem}"
                                 SelectionChanged="OnFileSelectionChanged"
                                 DoubleTapped="OnFileDoubleTapped"
                                 KeyDown="OnFileKeyDown"
                                 GotFocus="OnPaneGotFocus"
                                 AttachedToVisualTree="OnFileListAttached"
                                 IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsListView}">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="Margin" Value="4,1"/>
                                </Style>

                                <Style Selector="ListBoxItem:pressed:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>

                                <Style Selector="ListBoxItem:pressed:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                                </Style>
                            </ListBox.Styles>

                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileItemViewModel">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                                          Opacity="{Binding DisplayOpacity}"
                                          Classes.drop-target="{Binding IsDropTarget}">
                                        <Panel Grid.Column="0"
                                               Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColNameWidth}">
                                            <DockPanel Classes="drop-zone"
                                                       Background="Transparent"
                                                       VerticalAlignment="Center">
                                                <Panel DockPanel.Dock="Left"
                                                       Width="20"
                                                       Height="20"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}"
                                                           Width="18"
                                                           Height="18"
                                                           IsVisible="{Binding !HasThumbnail}"/>

                                                    <Border CornerRadius="3"
                                                            ClipToBounds="True"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            IsVisible="{Binding HasThumbnail}">
                                                        <Image Source="{Binding Thumbnail}"
                                                               MaxWidth="18"
                                                               MaxHeight="18"
                                                               Stretch="Uniform"/>
                                                    </Border>

                                                    <Border Classes="symlink-badge"
                                                            IsVisible="{Binding IsSymlink}"
                                                            Width="11"
                                                            Height="11"
                                                            CornerRadius="6"
                                                            Margin="0,0,-2,-2"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom">
                                                        <Path Data="M0,4 L4,0 M1,0 L4,0 L4,3"
                                                              StrokeThickness="1.2"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                </Panel>

                                                <Border DockPanel.Dock="Right"
                                                        Background="#444444"
                                                        CornerRadius="4"
                                                        Padding="4,1"
                                                        IsVisible="{Binding IsHidden}"
                                                        Margin="6,0,0,0">
                                                    <TextBlock Text="{markup:Translate Key=Hidden}"
                                                               Foreground="#CCCCCC"
                                                               FontSize="10"/>
                                                </Border>

                                                <Border DockPanel.Dock="Right"
                                                        Background="#D35400"
                                                        CornerRadius="4"
                                                        Padding="4,1"
                                                        IsVisible="{Binding IsAccessDenied}"
                                                        Margin="6,0,0,0">
                                                    <TextBlock Text="{markup:Translate Key=AccessDenied}"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="Bold"/>
                                                </Border>

                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Panel>

                                        <TextBlock Grid.Column="1"
                                                   Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColSizeWidth}"
                                                   Text="{Binding SizeString}"
                                                   Foreground="#999999"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Right"
                                                   Margin="0,0,16,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="2"
                                                   Width="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ColTypeWidth}"
                                                   Text="{Binding TypeString}"
                                                   Foreground="#999999"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding ModifiedString}"
                                                   Foreground="#888888"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- RubberBand Selection Overlay -->
                        <Canvas ClipToBounds="True"
                                IsHitTestVisible="False">
                            <Border BorderBrush="{DynamicResource SelectionBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource SelectionTranslucentBrush}"
                                    IsVisible="False"/>
                        </Canvas>
                    </Panel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">

        <!-- Top Menu Bar -->
        <Border Grid.Row="0"
                IsVisible="{Binding !IsPickerMode}"
                Background="#1E1E20"
                BorderBrush="#2C2C2C"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Menu x:Name="MainMenu"
                      Grid.Column="0">

                    <!-- File Menu -->
                    <MenuItem Header="{markup:Translate Key=File}">
                    <MenuItem Header="{markup:Translate Key=NewWindow}"
                              Icon="{markup:Icon Key=window}"
                              Click="OnMenuNewWindowClick"
                              InputGesture="{markup:Keybind Id=NewWindow}"/>

                    <MenuItem Header="{markup:Translate Key=OpenAsRoot}"
                              Icon="{markup:Icon Key=shield}"
                              Click="OnMenuOpenAsRootClick"/>

                    <MenuItem Header="{markup:Translate Key=ConnectToServer}"
                              Icon="{markup:Icon Key=network}"
                              Click="OnMenuConnectToServerClick"
                              InputGesture="{markup:Keybind Id=ConnectToServer}"/>

                    <Separator/>

                    <MenuItem Header="{markup:Translate Key=NewFolder}"
                              Icon="{markup:Icon Key=folder-new}"
                              Click="OnNewFolderClick"
                              InputGesture="{markup:Keybind Id=NewFolder}"/>
                              
                    <MenuItem Header="{markup:Translate Key=NewFile}"
                              Icon="{markup:Icon Key=file-new}"
                              Click="OnNewFileClick"
                              InputGesture="{markup:Keybind Id=NewFile}"/>

                    <Separator/>

                    <MenuItem Header="{markup:Translate Key=Properties}"
                              Icon="{markup:Icon Key=info}"
                              Click="OnMenuPropertiesClick"
                              InputGesture="{markup:Keybind Id=Properties}"/>

                    <Separator/>

                    <MenuItem Header="{markup:Translate Key=Close}"
                              Icon="{markup:Icon Key=close}"
                              Click="OnMenuCloseClick"
                              InputGesture="{markup:Keybind Id=Quit}"/>
                </MenuItem>

                <!-- Edit Menu -->
                <MenuItem Header="{markup:Translate Key=Edit}"
                          SubmenuOpened="OnEditMenuOpened">
                    <MenuItem Header="{markup:Translate Key=Cut}"
                              Icon="{markup:Icon Key=content-cut}"
                              Click="OnMenuCutClick"
                              InputGesture="{markup:Keybind Id=Cut}"/>

                    <MenuItem Header="{markup:Translate Key=Copy}"
                              Icon="{markup:Icon Key=content-copy}"
                              Click="OnMenuCopyClick"
                              InputGesture="{markup:Keybind Id=Copy}"/>

                    <MenuItem x:Name="EditPasteMenuItem"
                              Header="{markup:Translate Key=Paste}"
                              Icon="{markup:Icon Key=content-paste}"
                              Click="OnMenuPasteClick"
                              InputGesture="{markup:Keybind Id=Paste}"/>

                    <MenuItem x:Name="EditPasteSymlinkMenuItem"
                              Header="{markup:Translate Key=PasteAsSymlink}"
                              Icon="{markup:Icon Key=link}"
                              Click="OnMenuPasteAsSymlinkClick"
                              InputGesture="{markup:Keybind Id=PasteSymlink}"/>

                    <MenuItem Header="{markup:Translate Key=Duplicate}"
                              Icon="{markup:Icon Key=duplicate}"
                              Click="OnMenuDuplicateClick"
                              InputGesture="{markup:Keybind Id=Duplicate}"/>

                    <MenuItem Header="{markup:Translate Key=Rename}"
                              Icon="{markup:Icon Key=edit}"
                              Click="OnMenuRenameClick"
                              InputGesture="{markup:Keybind Id=Rename}"/>

                    <Separator/>

                    <MenuItem Header="{markup:Translate Key=SelectAll}"
                              Icon="{markup:Icon Key=select-all}"
                              Click="OnSelectAllClick"
                              InputGesture="{markup:Keybind Id=SelectAll}"/>
                </MenuItem>

                <!-- View Menu -->
                <MenuItem Header="{markup:Translate Key=View}"
                          SubmenuOpened="OnViewMenuOpened">
                    <MenuItem Header="{markup:Translate Key=Reload}"
                              Icon="{markup:Icon Key=refresh}"
                              Click="OnRefreshClick"
                              InputGesture="{markup:Keybind Id=Refresh}"/>

                    <MenuItem Header="{markup:Translate Key=ShowHidden}"
                              Icon="{markup:Icon Key=eye}"
                              Click="OnToggleHiddenClick"
                              InputGesture="{markup:Keybind Id=ToggleHidden}"/>

                    <Separator/>

                    <MenuItem Header="{markup:Translate Key=DualPane}"
                              Icon="{markup:Icon Key=split-pane}"
                              Click="OnToggleDualPaneClick"
                              InputGesture="{markup:Keybind Id=DualPane}"/>

                    <Separator/>

                    <MenuItem Header="{markup:Translate Key=IconView}"
                              Icon="{markup:Icon Key=view-grid}"
                              Click="OnSetGridViewClick"/>

                    <MenuItem Header="{markup:Translate Key=ListView}"
                              Icon="{markup:Icon Key=view-list}"
                              Click="OnSetListViewClick"/>

                    <MenuItem Header="{markup:Translate Key=SortBy}"
                              Icon="{markup:Icon Key=sort}">
                        <MenuItem x:Name="SortByNameMenuItem"
                                  Header="{markup:Translate Key=Name}"
                                  ToggleType="Radio"
                                  GroupName="SortColumn"
                                  Tag="Name"
                                  Click="OnSortColumnClick"/>

                        <MenuItem x:Name="SortBySizeMenuItem"
                                  Header="{markup:Translate Key=Size}"
                                  ToggleType="Radio"
                                  GroupName="SortColumn"
                                  Tag="Size"
                                  Click="OnSortColumnClick"/>

                        <MenuItem x:Name="SortByTypeMenuItem"
                                  Header="{markup:Translate Key=Type}"
                                  ToggleType="Radio"
                                  GroupName="SortColumn"
                                  Tag="Type"
                                  Click="OnSortColumnClick"/>

                        <MenuItem x:Name="SortByModifiedMenuItem"
                                  Header="{markup:Translate Key=Modified}"
                                  ToggleType="Radio"
                                  GroupName="SortColumn"
                                  Tag="Modified"
                                  Click="OnSortColumnClick"/>

                        <Separator/>

                        <MenuItem x:Name="SortAscendingMenuItem"
                                  Header="{markup:Translate Key=SortAscending}"
                                  ToggleType="Radio"
                                  GroupName="SortDirection"
                                  Tag="false"
                                  Click="OnSortDirectionClick"/>

                        <MenuItem x:Name="SortDescendingMenuItem"
                                  Header="{markup:Translate Key=SortDescending}"
                                  ToggleType="Radio"
                                  GroupName="SortDirection"
                                  Tag="true"
                                  Click="OnSortDirectionClick"/>
                    </MenuItem>

                    <MenuItem Header="{markup:Translate Key=GridFileNames}"
                              Icon="{markup:Icon Key=view-grid}">
                        <MenuItem x:Name="GridNamesTwoLinesMenuItem"
                                  Header="{markup:Translate Key=GridFileNamesTwoLines}"
                                  ToggleType="Radio"
                                  Tag="2"
                                  Click="OnGridNameLinesClick"/>

                        <MenuItem x:Name="GridNamesThreeLinesMenuItem"
                                  Header="{markup:Translate Key=GridFileNamesThreeLines}"
                                  ToggleType="Radio"
                                  Tag="3"
                                  Click="OnGridNameLinesClick"/>

                        <MenuItem x:Name="GridNamesFullMenuItem"
                                  Header="{markup:Translate Key=GridFileNamesFull}"
                                  ToggleType="Radio"
                                  Tag="0"
                                  Click="OnGridNameLinesClick"/>
                    </MenuItem>

                    <Separator/>

                    <MenuItem Header="{markup:Translate Key=ThemeColorsMenu}"
                              Icon="{markup:Icon Key=palette}"
                              Click="OnThemeColorsClick"/>

                    <MenuItem x:Name="SystemPickerMenuItem"
                              Header="{markup:Translate Key=UseAsSystemPicker}"
                              ToggleType="CheckBox"
                              Click="OnSystemPickerClick"/>
                </MenuItem>

                <!-- Go Menu -->
                <MenuItem Header="{markup:Translate Key=Go}">
                    <MenuItem Header="{markup:Translate Key=Back}"
                              Icon="{markup:Icon Key=arrow-left}"
                              Click="OnBackClick"
                              InputGesture="{markup:Keybind Id=Back}"/>

                    <MenuItem Header="{markup:Translate Key=Forward}"
                              Icon="{markup:Icon Key=arrow-right}"
                              Click="OnForwardClick"
                              InputGesture="{markup:Keybind Id=Forward}"/>

                    <MenuItem Header="{markup:Translate Key=Up}"
                              Icon="{markup:Icon Key=arrow-up}"
                              Click="OnUpClick"
                              InputGesture="{markup:Keybind Id=Up}"/>

                    <Separator/>

                    <MenuItem Header="{markup:Translate Key=Home}"
                              Icon="{markup:Icon Key=home}"
                              Click="OnGoHomeClick"/>

                    <MenuItem Header="{markup:Translate Key=Root}"
                              Icon="{markup:Icon Key=disk}"
                              Click="OnGoRootClick"/>

                    <MenuItem Header="{markup:Translate Key=Location}"
                              Icon="{markup:Icon Key=location}"
                              Click="OnTogglePathEditingClick"
                              InputGesture="{markup:Keybind Id=Location}"/>
                </MenuItem>

                <!-- Addons Menu -->
                <MenuItem x:Name="AddonsMenuItem"
                          Header="{markup:Translate Key=Addons}">
                    <MenuItem Header="{markup:Translate Key=ManageAddons}"
                              Icon="{markup:Icon Key=extension}"
                              Click="OnMenuManageAddonsClick"/>

                    <MenuItem Header="{markup:Translate Key=BrowseAddonStore}"
                              Icon="{markup:Icon Key=asset-store}"
                              Click="OnMenuAddonStoreClick"/>

                    <MenuItem Header="{markup:Translate Key=InstallAddonFolder}"
                              Icon="{markup:Icon Key=download}"
                              Click="OnMenuInstallAddonFolderClick"/>

                    <MenuItem Header="{markup:Translate Key=InstallAddonZip}"
                              Icon="{markup:Icon Key=extract}"
                              Click="OnMenuInstallAddonZipClick"/>

                    <Separator/>

                    <MenuItem Header="{markup:Translate Key=OpenAddonsFolder}"
                              Icon="{markup:Icon Key=open}"
                              Click="OnMenuOpenAddonsFolderClick"/>

                    <MenuItem Header="{markup:Translate Key=ReloadAddons}"
                              Icon="{markup:Icon Key=refresh}"
                              Click="OnMenuReloadAddonsClick"/>

                    <MenuItem Header="{markup:Translate Key=AddonProblems}"
                              Icon="{markup:Icon Key=warning}"
                              Click="OnAddonErrorsClick"/>
                </MenuItem>

                <!-- Help Menu -->
                <MenuItem Header="{markup:Translate Key=Help}">
                    <MenuItem Header="{markup:Translate Key=Shortcuts}"
                              Icon="{markup:Icon Key=keyboard}"
                              Click="OnMenuShortcutsClick"/>

                    <Separator/>

                    <MenuItem Header="{markup:Translate Key=About}"
                              Icon="{markup:Icon Key=info}"
                              Click="OnMenuAboutClick"/>
                </MenuItem>
            </Menu>

            <Border Grid.Column="2"
                    IsVisible="{Binding IsPrivilegedProcess}"
                    Background="#3B1818"
                    BorderBrush="#C0392B"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,12,0"
                    Padding="8,2"
                    VerticalAlignment="Center">
                <TextBlock Text="{markup:Translate Key=RootBadge}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#FF9E9E"/>
            </Border>
        </Grid>
    </Border>

        <!-- Top Toolbar -->
        <Border Grid.Row="1"
                Background="#242426"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <!-- Navigation controls -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button Click="OnBackClick"
                            IsEnabled="{Binding CanGoBack}"
                            ToolTip.Tip="{markup:Translate Key=Back}"
                            Background="Transparent">
                        <Image Source="{markup:Icon Key=arrow-left}"
                               Width="16"
                               Height="16"/>
                    </Button>

                    <Button Click="OnForwardClick"
                            IsEnabled="{Binding CanGoForward}"
                            ToolTip.Tip="{markup:Translate Key=Forward}"
                            Background="Transparent">
                        <Image Source="{markup:Icon Key=arrow-left}"
                               Width="16"
                               Height="16"
                               RenderTransform="rotate(180deg)"/>
                    </Button>

                    <Button Click="OnUpClick"
                            IsEnabled="{Binding CanGoUp}"
                            ToolTip.Tip="{markup:Translate Key=Up}"
                            Background="Transparent">
                        <Image Source="{markup:Icon Key=arrow-left}"
                               Width="16"
                               Height="16"
                               RenderTransform="rotate(90deg)"/>
                    </Button>

                    <Button Click="OnRefreshClick"
                            ToolTip.Tip="{markup:Translate Key=Reload}"
                            Background="Transparent">
                        <Image Source="{markup:Icon Key=refresh}"
                               Width="16"
                               Height="16"/>
                    </Button>
                </StackPanel>

                <!-- Breadcrumb Bar / Path Box -->
                <Grid Grid.Column="1"
                      Margin="8,0"
                      VerticalAlignment="Center">

                    <!-- Clickable Breadcrumb Bar -->
                    <Border Background="#18181A"
                            BorderBrush="#383838"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4,2"
                            PointerPressed="OnBreadcrumbBarPointerPressed"
                            IsVisible="{Binding !IsPathEditing}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Button Grid.Column="0"
                                    x:Name="BreadcrumbScrollLeftButton"
                                    Classes="crumb-scroll"
                                    Click="OnBreadcrumbScrollLeftClick"
                                    IsVisible="False">
                                <Image Source="{markup:Icon Key=arrow-left}"
                                       Width="12"
                                       Height="12"/>
                            </Button>

                            <ScrollViewer Grid.Column="1"
                                          x:Name="BreadcrumbsScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          ScrollChanged="OnBreadcrumbsScrollChanged">
                                <ItemsControl x:Name="BreadcrumbsItemsControl"
                                              ItemsSource="{Binding Breadcrumbs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:BreadcrumbItem">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="2">
                                                <Button Tag="{Binding FullPath}"
                                                        Click="OnBreadcrumbClick"
                                                        Classes="crumb"
                                                        Classes.current="{Binding IsCurrent}"
                                                        BorderThickness="0"
                                                        CornerRadius="4"
                                                        Padding="6,3"
                                                        FontSize="12">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </Button>

                                                <TextBlock Text="/"
                                                           Foreground="#666666"
                                                           VerticalAlignment="Center"
                                                           Margin="2,0"
                                                           IsVisible="{Binding !IsLast}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Button Grid.Column="2"
                                    x:Name="BreadcrumbScrollRightButton"
                                    Classes="crumb-scroll"
                                    Click="OnBreadcrumbScrollRightClick"
                                    IsVisible="False">
                                <Image Source="{markup:Icon Key=arrow-left}"
                                       Width="12"
                                       Height="12"
                                       RenderTransform="rotate(180deg)"/>
                            </Button>

                            <Button Grid.Column="3"
                                    Click="OnTogglePathEditingClick"
                                    ToolTip.Tip="{markup:Translate Key=Location}"
                                    Background="Transparent"
                                    Padding="4"
                                    CornerRadius="4">
                                <Image Source="{markup:Icon Key=edit}"
                                       Width="13"
                                       Height="13"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Manual Text Path Box -->
                    <TextBox x:Name="PathTextBox"
                             Text="{Binding CurrentPath, Mode=OneWay}"
                             KeyDown="OnPathKeyDown"
                             LostFocus="OnPathLostFocus"
                             Background="#18181A"
                             BorderBrush="#383838"
                             CornerRadius="6"
                             FontSize="13"
                             Padding="10,6"
                             IsVisible="{Binding IsPathEditing}"/>
                </Grid>

                <!-- Search Box -->
                <TextBox Grid.Column="2"
                         x:Name="SearchTextBox"
                         Text="{Binding SearchQuery}"
                         Watermark="{markup:Translate Key=SearchWatermark}"
                         Width="170"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Background="#18181A"
                         BorderBrush="#383838"
                         CornerRadius="6"
                         FontSize="13"
                         Padding="8,6"
                         KeyDown="OnSearchKeyDown"/>

                <!-- Toolbar Actions & View Mode Toggles -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">

                    <!-- Grid / List View Toggle Group -->
                    <Border Background="#18181A"
                            CornerRadius="6"
                            BorderBrush="#383838"
                            BorderThickness="1"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Click="OnSetGridViewClick"
                                    Classes="view-toggle"
                                    Classes.active="{Binding IsGridView}"
                                    ToolTip.Tip="{markup:Translate Key=IconView}"
                                    CornerRadius="5,0,0,5"
                                    Padding="7,5">
                                <Image Source="{markup:Icon Key=view-grid}"
                                       Width="14"
                                       Height="14"/>
                            </Button>

                            <Button Click="OnSetListViewClick"
                                    Classes="view-toggle"
                                    Classes.active="{Binding IsListView}"
                                    ToolTip.Tip="{markup:Translate Key=ListView}"
                                    CornerRadius="0,5,5,0"
                                    Padding="7,5">
                                <Image Source="{markup:Icon Key=view-list}"
                                       Width="14"
                                       Height="14"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Click="OnToggleDualPaneClick"
                            IsVisible="{Binding !IsPickerMode}"
                            Classes="view-toggle boxed"
                            Classes.active="{Binding IsDualPane}"
                            ToolTip.Tip="{markup:Translate Key=DualPane}"
                            CornerRadius="6"
                            Padding="6">
                        <Image Source="{markup:Icon Key=split-pane}"
                               Width="15"
                               Height="15"/>
                    </Button>

                    <ToggleButton IsChecked="{Binding ShowHiddenFiles}"
                                  ToolTip.Tip="{markup:Translate Key=ShowHidden}"
                                  Classes="view-toggle"
                                  CornerRadius="6">
                        <Image Source="{markup:Icon Key=eye}"
                               Width="16"
                               Height="16"/>
                    </ToggleButton>

                    <Button Click="OnOpenTerminalClick"
                            ToolTip.Tip="{markup:Translate Key=OpenTerminal}"
                            Background="Transparent">
                        <Image Source="{markup:Icon Key=terminal}"
                               Width="16"
                               Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"
                                  MinWidth="150"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"
                                  MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar (Places, Bookmarks, Devices, Network) with Drag & Drop Reordering -->
            <Border Grid.Column="0"
                    Background="#18181A"
                    Padding="6,8">
                <ListBox x:Name="SidebarListBox"
                         ItemsSource="{Binding Places}"
                         SelectionChanged="OnPlaceSelected"
                         Background="Transparent"
                         DragDrop.AllowDrop="True"
                         CornerRadius="6"
                         AutoScrollToSelectedItem="False"
                         Focusable="True">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem"
                               x:DataType="m:PlaceItem">
                            <Setter Property="IsVisible"
                                    Value="{Binding IsVisible}"/>
                            <Setter Property="CornerRadius"
                                    Value="6"/>
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Margin"
                                    Value="0,1"/>
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                        </Style>

                        <Style Selector="Button.sidebar-action-btn">
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="CornerRadius"
                                    Value="4"/>
                            <Setter Property="Padding"
                                    Value="6,4"/>
                            <Setter Property="BorderThickness"
                                    Value="0"/>
                        </Style>

                        <Style Selector="Button.sidebar-action-btn:pointerover">
                            <Setter Property="Background"
                                    Value="#383838"/>
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="SidebarContextMenu"
                                     Opening="OnSidebarContextMenuOpening"
                                     Closed="OnSidebarContextMenuClosed">
                            <MenuItem x:Name="SidebarOpenMenuItem"
                                      Header="{markup:Translate Key=Open}"
                                      Icon="{markup:Icon Key=open}"
                                      Click="OnSidebarOpenClick"/>

                            <MenuItem x:Name="SidebarConnectMenuItem"
                                      Header="{markup:Translate Key=Connect}"
                                      Icon="{markup:Icon Key=link}"
                                      Click="OnSidebarConnectClick"/>

                            <MenuItem x:Name="SidebarDismountMenuItem"
                                      Header="{markup:Translate Key=Dismount}"
                                      Icon="{markup:Icon Key=eject}"
                                      Click="OnSidebarDismountClick"/>

                            <MenuItem x:Name="SidebarConnectToServerMenuItem"
                                      Header="{markup:Translate Key=ConnectToServer}"
                                      Icon="{markup:Icon Key=network}"
                                      Click="OnSidebarConnectToServerClick"/>

                            <MenuItem x:Name="SidebarResetPlacesMenuItem"
                                      Header="{markup:Translate Key=ResetLayout}"
                                      Icon="{markup:Icon Key=refresh}"
                                      Click="OnSidebarResetPlacesClick"/>

                            <Separator x:Name="SidebarSeparator"/>

                            <MenuItem x:Name="SidebarRemoveBookmarkMenuItem"
                                      Header="{markup:Translate Key=RemoveBookmark}"
                                      Icon="{markup:Icon Key=close}"
                                      Click="OnSidebarRemoveBookmarkClick"/>

                            <MenuItem x:Name="SidebarRenameServerMenuItem"
                                      Header="{markup:Translate Key=RenameConnection}"
                                      Icon="{markup:Icon Key=edit}"
                                      Click="OnSidebarRenameServerClick"/>

                            <MenuItem x:Name="SidebarRemoveServerMenuItem"
                                      Header="{markup:Translate Key=RemoveServer}"
                                      Icon="{markup:Icon Key=close}"
                                      Click="OnSidebarRemoveServerClick"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:PlaceItem">
                            <Grid Margin="0,1">

                                <!-- Top drop line indicator -->
                                <Rectangle Height="2"
                                           Fill="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Top"
                                           Margin="4,0"
                                           IsVisible="{Binding ShowDropLineAbove}"/>

                                <Border CornerRadius="6"
                                        Padding="8,5"
                                        Classes.drop-target="{Binding IsDropTarget}">
                                    <Panel>
                                        <Grid ColumnDefinitions="*,Auto"
                                              IsVisible="{Binding IsHeader}"
                                              Background="Transparent"
                                              Cursor="Hand">
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Chevron}"
                                                           FontSize="9"
                                                           Foreground="#777777"
                                                           VerticalAlignment="Center"
                                                           Margin="4,6,0,2"/>

                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="#777777"
                                                           Margin="0,6,6,2"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Classes="sidebar-action-btn"
                                                    Click="OnSidebarConnectToServerClick"
                                                    IsVisible="{Binding IsNetworkHeader}"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="{markup:Translate Key=ConnectToServer}">
                                                <Image Source="{markup:Icon Key=network}"
                                                       Width="14"
                                                       Height="14"
                                                       Opacity="0.7"/>
                                            </Button>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto"
                                              IsVisible="{Binding !IsHeader}">
                                            <Grid Grid.Column="0"
                                                  ColumnDefinitions="Auto,*"
                                                  Margin="0,0,6,0">
                                                <Image Grid.Column="0"
                                                       Source="{Binding Icon}"
                                                       Width="16"
                                                       Height="16"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontSize="13"/>
                                            </Grid>

                                            <Button Grid.Column="1"
                                                    Classes="sidebar-action-btn"
                                                    Click="OnSidebarDismountButtonClick"
                                                    IsVisible="{Binding CanDismount}"
                                                    Cursor="Hand"
                                                    ToolTip.Tip="{markup:Translate Key=Dismount}">
                                                <Image Source="{markup:Icon Key=disk}"
                                                       Width="14"
                                                       Height="14"
                                                       Opacity="0.6"/>
                                            </Button>
                                        </Grid>
                                    </Panel>
                                </Border>

                                <!-- Bottom drop line indicator -->
                                <Rectangle Height="2"
                                           Fill="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0"
                                           IsVisible="{Binding ShowDropLineBelow}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Splitter between Sidebar and Panes -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          Background="#282828"
                          ResizeDirection="Columns"/>

            <!-- File Panes Area (Supports Single Pane or F3 Dual Pane) -->
            <Grid Grid.Column="2"
                  x:Name="FilePanesGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"
                                      MinWidth="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0"
                                      MinWidth="{Binding SecondaryPaneMinWidth}"/>
                </Grid.ColumnDefinitions>

                <!-- Pane 1 (Primary Pane) -->
                <ContentControl Grid.Column="0"
                                Content="{Binding Pane1}"
                                ContentTemplate="{StaticResource FilePaneTemplate}"/>

                <!-- Dual Pane Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              Background="#282828"
                              ResizeDirection="Columns"
                              IsVisible="{Binding IsDualPane}"/>

                <!-- Pane 2 (F3 Dual Pane Secondary Pane) -->
                <ContentControl Grid.Column="2"
                                Content="{Binding Pane2}"
                                ContentTemplate="{StaticResource FilePaneTemplate}"
                                IsVisible="{Binding IsDualPane}"/>
            </Grid>
        </Grid>

        <!-- File Operation Progress Panel (Nemo Style) -->
        <Border Grid.Row="3"
                Background="#232326"
                BorderBrush="#2F2F35"
                BorderThickness="0,1,0,1"
                Padding="16,10"
                IsVisible="{Binding IsOperationInProgress}">
            <StackPanel Spacing="10">

                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding HasMultipleOperations}">

                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Operations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OperationProgressViewModel">
                                    <Button Classes="operation-tab"
                                            Classes.selected="{Binding IsSelected}"
                                            Tag="{Binding}"
                                            Click="OnOperationTabClick">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">

                                            <Image Source="{Binding Icon}"
                                                   Width="12"
                                                   Height="12"
                                                   VerticalAlignment="Center"/>

                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11"
                                                       MaxWidth="180"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Text="{Binding PercentText}"
                                                       FontSize="11"
                                                       Foreground="#88888E"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">

                        <Button Classes="crumb-scroll"
                                Click="OnPreviousOperationClick"
                                ToolTip.Tip="{markup:Translate Key=PreviousOperation}">
                            <Image Source="{markup:Icon Key=arrow-left}"
                                   Width="12"
                                   Height="12"/>
                        </Button>

                        <TextBlock Text="{Binding OperationPosition}"
                                   FontSize="11"
                                   Foreground="#88888E"
                                   VerticalAlignment="Center"/>

                        <Button Classes="crumb-scroll"
                                Click="OnNextOperationClick"
                                ToolTip.Tip="{markup:Translate Key=NextOperation}">
                            <Image Source="{markup:Icon Key=arrow-right}"
                                   Width="12"
                                   Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid DataContext="{Binding SelectedOperation}"
                      x:DataType="vm:OperationProgressViewModel"
                      ColumnDefinitions="Auto,*,Auto"
                      RowDefinitions="Auto,Auto,Auto">

                    <!-- Icon -->
                    <Panel Grid.Row="0"
                           Grid.RowSpan="3"
                           Grid.Column="0"
                           Width="36"
                           Height="36"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center">
                        <Image Source="{Binding Icon}"
                               Width="26"
                               Height="26"/>
                    </Panel>

                    <!-- Top Row: Title and Status -->
                    <Grid Grid.Row="0"
                          Grid.Column="1"
                          ColumnDefinitions="*,Auto"
                          Margin="0,0,0,6">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Status}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AccentLightBrush}"
                                   FontWeight="Medium"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <!-- Middle Row: Progress Bar -->
                    <ProgressBar Grid.Row="1"
                                 Grid.Column="1"
                                 Minimum="0"
                                 Maximum="{Binding Maximum}"
                                 Value="{Binding Value}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Height="6"
                                 CornerRadius="3"
                                 Background="#38383E"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Margin="0,0,0,6"/>

                    <!-- Bottom Row: Text and Current Item -->
                    <Grid Grid.Row="2"
                          Grid.Column="1"
                          ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Text}"
                                   FontSize="12"
                                   Foreground="#CCCCCC"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding Item}"
                                   FontSize="12"
                                   Foreground="#88888E"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="300"/>
                    </Grid>

                    <!-- Cancel Button -->
                    <Button Grid.Row="0"
                            Grid.RowSpan="3"
                            Grid.Column="2"
                            Click="OnCancelOperationClick"
                            IsVisible="{Binding CanCancel}"
                            Background="Transparent"
                            BorderBrush="#44444A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <Image Source="{markup:Icon Key=close}"
                                   Width="12"
                                   Height="12"/>

                            <TextBlock Text="{markup:Translate Key=Cancel}"
                                       FontSize="12"
                                       Foreground="#EEEEEE"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Picker Action Bar -->
        <Border Grid.Row="4"
                IsVisible="{Binding IsPickerMode}"
                Background="#202022"
                BorderBrush="#2C2C2C"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">

                <Button Grid.Column="0"
                        Classes="addon-errors"
                        Click="OnAddonErrorsClick"
                        IsVisible="{Binding HasAddonErrors}"
                        ToolTip.Tip="{markup:Translate Key=AddonErrorsTooltip}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <Image Source="{markup:Icon Key=warning}"
                               Width="14"
                               Height="14"/>

                        <TextBlock Text="{Binding AddonErrorCount}"
                                   FontSize="12"
                                   Foreground="#E0A040"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="{Binding PickerTargetLabel}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#AAAAAA"
                           Margin="0,0,12,0"/>

                <TextBox Grid.Column="2"
                         x:Name="PickerNameTextBox"
                         Text="{Binding PickerSelectedName, Mode=TwoWay}"
                         KeyDown="OnPickerTextBoxKeyDown"
                         VerticalAlignment="Center"
                         FontSize="13"
                         CornerRadius="6"
                         Margin="0,0,16,0"/>

                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding PickerFilters}"
                          SelectedItem="{Binding SelectedPickerFilter, Mode=TwoWay}"
                          IsVisible="{Binding HasPickerFilters}"
                          VerticalAlignment="Center"
                          MinWidth="160"
                          MaxWidth="260"
                          CornerRadius="6"
                          Margin="0,0,16,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PickerFilter">
                            <TextBlock Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="4"
                        Content="{markup:Translate Key=Cancel}"
                        Click="OnPickerCancelClick"
                        Background="#333333"
                        Foreground="#DDDDDD"
                        Padding="16,7"
                        Margin="0,0,8,0"
                        CornerRadius="6"/>

                <Button Grid.Column="5"
                        Content="{Binding PickerActionButtonText}"
                        Click="OnPickerConfirmClick"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="18,7"
                        CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="5"
                IsVisible="{Binding !IsPickerMode}"
                Background="#18181A"
                BorderBrush="#2A2A2A"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="#888888"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding AddonStatusItems}"
                              VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AddonStatusItemViewModel">
                            <Button Classes="addon-status"
                                    Classes.clickable="{Binding IsClickable}"
                                    Tag="{Binding}"
                                    Click="OnAddonStatusItemClick"
                                    ToolTip.Tip="{Binding Tooltip}"
                                    ToolTip.ServiceEnabled="{Binding HasTooltip}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="5">
                                    <Image Source="{Binding Icon}"
                                           IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Width="12"
                                           Height="12"
                                           VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding Text}"
                                               FontSize="12"
                                               Foreground="#AAAAAA"
                                               MaxWidth="260"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Grid.Column="2"
                        Classes="addon-errors"
                        Click="OnAddonErrorsClick"
                        IsVisible="{Binding HasAddonErrors}"
                        ToolTip.Tip="{markup:Translate Key=AddonErrorsTooltip}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <Image Source="{markup:Icon Key=warning}"
                               Width="14"
                               Height="14"/>

                        <TextBlock Text="{Binding AddonErrorCount}"
                                   FontSize="12"
                                   Foreground="#E0A040"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
