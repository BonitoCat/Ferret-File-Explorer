<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.17" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FileExplorer.Core\FileExplorer.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
        <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Dialogs\ConflictDialog.axaml.cs">
        <DependentUpon>ConflictDialog.axaml</DependentUpon>
      </Compile>
      <Compile Update="Dialogs\ExtractDialog.axaml.cs">
        <DependentUpon>ExtractDialog.axaml</DependentUpon>
      </Compile>
      <Compile Update="Dialogs\AddonStoreDialog.axaml.cs">
        <DependentUpon>AddonStoreDialog.axaml</DependentUpon>
      </Compile>
    </ItemGroup>
</Project>
