<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileExplorer.Gui.App"
             Name="ferret"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme/>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>

        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="MaxWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="8"/>
            <Setter Property="MinHeight" Value="8"/>
            <Setter Property="MaxHeight" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ScrollBar /template/ Grid#Root">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ScrollBar[IsExpanded=true] /template/ Grid#Root">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="ScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="ScrollBar[IsExpanded=true] /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="MaxWidth" Value="6"/>
        </Style>

        <Style Selector="ScrollBar:horizontal /template/ Thumb">
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="MaxHeight" Value="6"/>
        </Style>

        <Style Selector="ScrollBar[IsExpanded=true] /template/ Thumb">
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Background" Value="#666666"/>
        </Style>

        <Style Selector="ScrollBar /template/ Thumb /template/ Border">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style Selector="ScrollBar /template/ Thumb:pointerover /template/ Border">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="ScrollBar /template/ Thumb:pressed /template/ Border">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
    </Application.Styles>
</Application>