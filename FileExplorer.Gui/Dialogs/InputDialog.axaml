<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="using:FileExplorer.Gui.Markup"
        x:Class="FileExplorer.Gui.Dialogs.InputDialog"
        Title="{markup:Translate Key=Input}"
        Width="380"
        Height="160"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#242426"
        Foreground="#E0E0E0">

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="18">

        <TextBlock Grid.Row="0"
                   x:Name="PromptLabel"
                   Text="{markup:Translate Key=EnterText}"
                   FontSize="13"
                   Margin="0,0,0,10"/>

        <TextBox Grid.Row="1"
                 x:Name="InputTextBox"
                 VerticalAlignment="Center"
                 CornerRadius="6"
                 FontSize="13">
            <TextBox.InnerRightContent>
                <Button x:Name="TogglePasswordButton"
                        Width="30"
                        Height="30"
                        Margin="0,0,2,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnTogglePasswordClick"
                        IsVisible="False">
                    <Image x:Name="TogglePasswordIcon"
                           Width="18"
                           Height="18"/>
                </Button>
            </TextBox.InnerRightContent>
        </TextBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">

            <Button Content="{markup:Translate Key=Cancel}"
                    Click="OnCancelClick"
                    Background="#333333"
                    MinWidth="75"
                    Padding="14,6"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"/>

            <Button Content="{markup:Translate Key=OK}"
                    Click="OnOkClick"
                    Background="#3584E4"
                    Foreground="White"
                    MinWidth="75"
                    Padding="14,6"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
