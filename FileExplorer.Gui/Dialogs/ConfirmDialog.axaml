<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="using:FileExplorer.Gui.Markup"
        x:Class="FileExplorer.Gui.Dialogs.ConfirmDialog"
        Title="{markup:Translate Key=ConfirmDeletionTitle}"
        Width="420"
        MinHeight="170"
        MaxHeight="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#242426"
        Foreground="#E0E0E0">

    <Grid RowDefinitions="*,Auto"
          Margin="20">

        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="14"
              VerticalAlignment="Center">

            <Image x:Name="IconImage"
                   Grid.Column="0"
                   Source="{markup:Icon Key=warning}"
                   Width="32"
                   Height="32"
                   VerticalAlignment="Center"/>

            <ScrollViewer Grid.Column="1"
                          MaxHeight="480"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText"
                           Text="{markup:Translate Key=ConfirmDeleteItem}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"/>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">

            <Button x:Name="CancelButton"
                    Content="{markup:Translate Key=Cancel}"
                    Click="OnCancelClick"
                    Background="#333333"
                    MinWidth="80"
                    Padding="14,6"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"/>

            <Button x:Name="ConfirmButton"
                    Content="{markup:Translate Key=OK}"
                    Click="OnConfirmClick"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    MinWidth="80"
                    Padding="14,6"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
