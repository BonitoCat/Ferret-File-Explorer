<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="using:FileExplorer.Gui.Markup"
        x:Class="FileExplorer.Gui.Dialogs.OpenWithDialog"
        Title="{markup:Translate Key=OpenWith}"
        Width="440"
        Height="260"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#242426"
        Foreground="#E0E0E0">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
          Margin="20">

        <TextBlock Grid.Row="0"
                   Text="{markup:Translate Key=ChooseProgram}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1"
                   Text="{markup:Translate Key=CommandOrExecutable}"
                   FontSize="12"
                   Foreground="#AAAAAA"
                   Margin="0,0,0,6"/>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              VerticalAlignment="Top">

            <TextBox Grid.Column="0"
                     x:Name="CommandTextBox"
                     CornerRadius="6,0,0,6"
                     FontSize="13"
                     Watermark="{markup:Translate Key=OpenWithWatermark}"/>

            <Button Grid.Column="1"
                    Click="OnBrowseProgramClick"
                    Background="#333338"
                    BorderBrush="#3E3E42"
                    BorderThickness="0,1,1,1"
                    CornerRadius="0,6,6,0"
                    Padding="10,0"
                    Height="32"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="{markup:Translate Key=BrowseForProgram}">
                <Image Source="{markup:Icon Key=folder}"
                       Width="15"
                       Height="15"/>
            </Button>
        </Grid>

        <CheckBox Grid.Row="3"
                  x:Name="AlwaysOpenCheckBox"
                  Content="{markup:Translate Key=AlwaysOpenWith}"
                  Margin="0,12,0,0"
                  FontSize="12"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">

            <Button Content="{markup:Translate Key=Cancel}"
                    Click="OnCancelClick"
                    Background="#333333"
                    Width="80"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    CornerRadius="6"/>

            <Button Content="{markup:Translate Key=OK}"
                    Click="OnOkClick"
                    Background="#3584E4"
                    Foreground="White"
                    Width="80"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    CornerRadius="6"/>
        </StackPanel>
    </Grid>
</Window>
