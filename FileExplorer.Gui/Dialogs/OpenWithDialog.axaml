<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="using:FileExplorer.Gui.Markup"
        xmlns:controls="using:FileExplorer.Gui.Controls"
        x:Class="FileExplorer.Gui.Dialogs.OpenWithDialog"
        Title="{markup:Translate Key=OpenWith}"
        Width="460"
        Height="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#242426"
        Foreground="#E0E0E0">

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Margin="20">

        <TextBlock Grid.Row="0"
                   Text="{markup:Translate Key=ChooseProgram}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <controls:AppChooser Grid.Row="1"
                             x:Name="Chooser"/>

        <CheckBox Grid.Row="2"
                  x:Name="AlwaysOpenCheckBox"
                  Content="{markup:Translate Key=AlwaysOpenWith}"
                  Margin="0,12,0,0"
                  FontSize="12"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">

            <Button Content="{markup:Translate Key=Cancel}"
                    Click="OnCancelClick"
                    Background="#333333"
                    MinWidth="80"
                    Padding="14,6"
                    HorizontalContentAlignment="Center"
                    IsCancel="True"
                    CornerRadius="6"/>

            <Button Content="{markup:Translate Key=OK}"
                    Click="OnOkClick"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    MinWidth="80"
                    Padding="14,6"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    CornerRadius="6"/>
        </StackPanel>
    </Grid>
</Window>
