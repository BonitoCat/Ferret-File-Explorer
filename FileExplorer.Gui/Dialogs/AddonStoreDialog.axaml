<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markup="using:FileExplorer.Gui.Markup"
        xmlns:vm="using:FileExplorer.Gui.ViewModels"
        x:Class="FileExplorer.Gui.Dialogs.AddonStoreDialog"
        Title="{markup:Translate Key=AddonStore}"
        Width="760"
        Height="580"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#242426"
        Foreground="#E0E0E0">

    <Window.Styles>
        <Style Selector="Button.install">
            <Setter Property="Background"
                    Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
            <Setter Property="MinWidth"
                    Value="96"/>
            <Setter Property="Padding"
                    Value="12,5"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style Selector="Button.install:disabled /template/ ContentPresenter">
            <Setter Property="Background"
                    Value="#333333"/>
            <Setter Property="Foreground"
                    Value="#999999"/>
        </Style>

        <Style Selector="Button.page">
            <Setter Property="Background"
                    Value="#333333"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
            <Setter Property="Padding"
                    Value="10,5"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Margin="20">

        <StackPanel Grid.Row="0"
                    Spacing="4"
                    Margin="0,0,0,12">

            <StackPanel Orientation="Horizontal"
                        Spacing="8">

                <Image Source="{markup:Icon Key=extension}"
                       Width="20"
                       Height="20"/>

                <TextBlock Text="{markup:Translate Key=AddonStore}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="{markup:Translate Key=AddonStoreHint}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#888888"/>
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,10">

            <TextBox Grid.Column="0"
                     x:Name="SearchBox"
                     CornerRadius="6"
                     FontSize="12"
                     Watermark="{markup:Translate Key=AddonStoreSearch}"
                     TextChanged="OnSearchChanged"/>

            <Button Grid.Column="1"
                    x:Name="RefreshButton"
                    Classes="page"
                    ToolTip.Tip="{markup:Translate Key=AddonStoreRefresh}"
                    Click="OnRefreshClick"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch">
                <Image Source="{markup:Icon Key=refresh}"
                       Width="16"
                       Height="16"/>
            </Button>
        </Grid>

        <Border Grid.Row="2"
                Background="#1E1E20"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="6">
            <Panel>
                <ListBox x:Name="AddonsList"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AddonStoreItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  Margin="0,6">

                                <Image Grid.Column="0"
                                       Source="{Binding Icon}"
                                       IsVisible="{Binding HasIcon}"
                                       Width="36"
                                       Height="36"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Top"/>

                                <StackPanel Grid.Column="1"
                                            Spacing="2">

                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>

                                    <TextBlock Text="{Binding Details}"
                                               IsVisible="{Binding HasDetails}"
                                               FontSize="11"
                                               Foreground="#888888"/>

                                    <TextBlock Text="{Binding Description}"
                                               IsVisible="{Binding HasDescription}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="#BBBBBB"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Spacing="6"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">

                                    <Button Classes="install"
                                            Tag="{Binding}"
                                            Content="{Binding ActionText}"
                                            IsEnabled="{Binding CanInstall}"
                                            Click="OnInstallClick"/>

                                    <ProgressBar Height="3"
                                                 Minimum="0"
                                                 Maximum="1"
                                                 Value="{Binding Progress}"
                                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                 IsVisible="{Binding IsInstalling}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="StatusText"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="12"
                           Foreground="#888888"
                           Margin="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Panel>
        </Border>

        <Grid Grid.Row="3"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto"
              Margin="0,16,0,0">

            <Button Grid.Column="0"
                    x:Name="PreviousPageButton"
                    Classes="page"
                    Click="OnPreviousPageClick">
                <Image Source="{markup:Icon Key=arrow-left}"
                       Width="14"
                       Height="14"/>
            </Button>

            <TextBlock Grid.Column="1"
                       x:Name="PageText"
                       FontSize="12"
                       Foreground="#AAAAAA"
                       Margin="10,0"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="2"
                    x:Name="NextPageButton"
                    Classes="page"
                    Click="OnNextPageClick">
                <Image Source="{markup:Icon Key=arrow-right}"
                       Width="14"
                       Height="14"/>
            </Button>

            <TextBlock Grid.Column="3"
                       x:Name="OfflineText"
                       Text="{markup:Translate Key=AddonStoreOffline}"
                       IsVisible="False"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="#E3B341"
                       Margin="12,0"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="4"
                    Content="{markup:Translate Key=Close}"
                    Click="OnCloseClick"
                    Background="{DynamicResource AccentBrush}"
                    Foreground="White"
                    MinWidth="90"
                    Padding="14,6"
                    HorizontalContentAlignment="Center"
                    CornerRadius="6"
                    IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
