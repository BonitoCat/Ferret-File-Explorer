[Desktop Entry]
Name=Ferret
GenericName=File Explorer
Comment=Ferret File Explorer
Exec=ferret %U
Icon=fe
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=fe-file-explorer
Categories=GNOME;GTK;Utility;Core;FileManager;
MimeType=inode/directory;
Keywords=file;files;folder;explorer;browser;manager;ferret;file explorer;
Actions=new-window;open-home;open-documents;open-downloads;open-computer;open-network;open-trash;

[Desktop Action new-window]
Name=New Window
Name[de]=Neues Fenster
Icon=folder-new
Exec=ferret %U

[Desktop Action open-home]
Name=Home
Name[de]=Persönlicher Ordner
Icon=user-home
Exec=ferret xdg:home

[Desktop Action open-documents]
Name=Documents
Name[de]=Dokumente
Icon=folder-documents
Exec=ferret xdg:documents

[Desktop Action open-downloads]
Name=Downloads
Name[de]=Downloads
Icon=folder-download
Exec=ferret xdg:downloads

[Desktop Action open-computer]
Name=Computer
Name[de]=Rechner
Icon=computer
Exec=ferret computer:///

[Desktop Action open-network]
Name=Network
Name[de]=Netzwerk
Icon=network-workgroup
Exec=ferret network:///

[Desktop Action open-trash]
Name=Trash
Name[de]=Papierkorb
Icon=user-trash
Exec=ferret trash:///
